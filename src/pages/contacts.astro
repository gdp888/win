---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { site } from '../lib/site';
---

<Base
  path="/contacts/"
  title="Контакты"
  description="Свяжитесь с нами: телефон, e-mail, адрес в Москве. Бесплатный выезд замерщика по Москве и МО."
>
  <Section variant="paper" padding="lg">
    <p class="eyebrow">Контакты</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">Свяжитесь с нами</h1>
    <p class="mt-5 max-w-2xl text-graphite">
      Позвоните или оставьте заявку — замерщик бесплатно выедет по Москве и МО.
      Расчёт стоимости — в течение одного рабочего дня.
    </p>
  </Section>

  <!-- Контактные блоки -->
  <Section variant="cream" padding="md">
    <div class="grid grid-cols-1 gap-px bg-mist md:grid-cols-3">
      <div class="bg-paper p-6">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-graphite-soft">Телефон</h2>
        <p class="mt-3">
          <a href={`tel:${site.phoneHref}`} class="text-xl font-medium text-anthracite hover:text-bronze">
            {site.phone}
          </a>
        </p>
        <p class="mt-1 text-xs text-graphite-soft">{site.workHours}</p>
      </div>
      <div class="bg-paper p-6">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-graphite-soft">E-mail</h2>
        <p class="mt-3">
          <a href={`mailto:${site.email}`} class="text-xl font-medium text-anthracite hover:text-bronze">
            {site.email}
          </a>
        </p>
        <p class="mt-1 text-xs text-graphite-soft">Ответим в течение дня</p>
      </div>
      <div class="bg-paper p-6">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-graphite-soft">Адрес</h2>
        <p class="mt-3 text-xl font-medium text-anthracite">
          {site.address.locality}
        </p>
        <p class="mt-1 text-sm text-graphite">{site.address.street}</p>
        <p class="mt-1 text-xs text-graphite-soft">{site.address.region}</p>
      </div>
    </div>

    <!-- Карта-плейсхолдер -->
    <div class="mt-8 grid aspect-[16/9] w-full place-items-center rounded-md border border-mist bg-cream text-center">
      <div>
        <p class="text-sm font-medium text-graphite">Карта (заглушка)</p>
        <p class="mt-1 text-xs text-graphite-soft">
          Подключить Яндекс.Карты / 2GIS embed после уточнения реального адреса
        </p>
      </div>
    </div>
  </Section>

  <!-- Форма заявки -->
  <Section variant="paper" padding="lg" id="form">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="eyebrow">Заявка</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
          Оставьте заявку — перезвоним за 30 минут
        </h2>
        <p class="mt-4 text-graphite">
          Заполните форму или позвоните. Бесплатный выезд замерщика по Москве и МО.
        </p>
        <ul class="mt-6 space-y-2 text-sm text-graphite">
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 rounded-full bg-bronze"></span>
            Ответим в рабочее время — за 30 минут
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 rounded-full bg-bronze"></span>
            Замер — бесплатно
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1 w-1 rounded-full bg-bronze"></span>
            Не передаём данные третьим лицам
          </li>
        </ul>
      </div>

      <form
        class="md:col-span-7 space-y-5"
        method="POST"
        action="https://qform.ru/your-form-id"
        data-form
      >
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium text-graphite">Имя</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="mt-1.5 w-full rounded-md border border-mist bg-paper px-3.5 py-2.5 text-sm text-anthracite transition-colors placeholder:text-graphite-soft focus:border-bronze focus:outline-none"
              placeholder="Как к вам обращаться"
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-graphite">Телефон</span>
            <input
              type="tel"
              name="phone"
              required
              autocomplete="tel"
              class="mt-1.5 w-full rounded-md border border-mist bg-paper px-3.5 py-2.5 text-sm text-anthracite transition-colors placeholder:text-graphite-soft focus:border-bronze focus:outline-none"
              placeholder="+7 (___) ___-__-__"
            />
          </label>
        </div>

        <label class="block">
          <span class="text-sm font-medium text-graphite">Что вас интересует</span>
          <select
            name="service"
            class="mt-1.5 w-full rounded-md border border-mist bg-paper px-3.5 py-2.5 text-sm text-anthracite transition-colors focus:border-bronze focus:outline-none"
          >
            <option value="windows">Алюминиевые окна</option>
            <option value="doors">Алюминиевые двери</option>
            <option value="sliding">Раздвижные системы</option>
            <option value="facades">Фасадное остекление</option>
            <option value="pergolas">Перголы и навесы</option>
            <option value="partitions">Перегородки</option>
            <option value="other">Другое / консультация</option>
          </select>
        </label>

        <label class="block">
          <span class="text-sm font-medium text-graphite">Комментарий</span>
          <textarea
            name="message"
            rows="4"
            class="mt-1.5 w-full rounded-md border border-mist bg-paper px-3.5 py-2.5 text-sm text-anthracite transition-colors placeholder:text-graphite-soft focus:border-bronze focus:outline-none"
            placeholder="Адрес объекта, размеры проёма, сроки, особенности..."
          ></textarea>
        </label>

        <label class="flex items-start gap-3 text-xs text-graphite-soft">
          <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 rounded border-mist text-bronze focus:ring-bronze" />
          <span>
            Согласен с <a href="/privacy/" class="text-bronze underline">политикой обработки персональных данных</a>
            в соответствии с 152-ФЗ.
          </span>
        </label>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <Button type="submit" size="lg">Отправить заявку</Button>
          <span class="text-xs text-graphite-soft">
            или напишите в
            <a href={site.social.telegram} class="text-bronze hover:underline">Telegram</a> ·
            <a href={site.social.whatsapp} class="text-bronze hover:underline">WhatsApp</a>
          </span>
        </div>

        <p class="text-xs text-graphite-soft">
          <span aria-hidden="true">⚠</span>
          Заглушка: в <code class="rounded bg-cream px-1">action</code> формы сейчас стоит
          <code class="rounded bg-cream px-1">https://qform.ru/your-form-id</code>. Перед продакшеном
          подключить реальный аккаунт qform.ru / Formspree / Cloudflare Worker → Telegram.
        </p>
      </form>
    </div>
  </Section>
</Base>
