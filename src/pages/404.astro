---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
---

<Base title="Страница не найдена" noindex={true}>
  <Section variant="paper" padding="lg">
    <div class="mx-auto max-w-xl text-center">
      <p class="eyebrow">Ошибка 404</p>
      <h1 class="mt-3 text-5xl font-semibold tracking-tight md:text-7xl">404</h1>
      <p class="mt-4 text-graphite">
        Страница, которую вы ищете, не существует или была перемещена.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg">На главную</Button>
        <Button href="/services/" variant="secondary" size="lg">К услугам</Button>
      </div>
    </div>
  </Section>
</Base>
