---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import { site } from '../lib/site';

const services = [
  {
    slug: 'windows',
    title: 'Алюминиевые окна',
    intro: 'Тёплые и холодные алюминиевые окна для квартир, частных домов и коммерческих помещений.',
    points: [
      'Тёплые системы с терморазрывом (Алютех WS-160, Алюмарк ALT-62, Татпроф 450-1)',
      'Холодные системы для неотапливаемых помещений (балконы, лоджии, террасы)',
      'Поворотно-откидная, поворотная и глухая фурнитура',
      'Стеклопакеты: однокамерные, двухкамерные, энергосберегающие, мультифункциональные',
      'Шумоизоляция до 42 дБ',
    ],
  },
  {
    slug: 'doors',
    title: 'Алюминиевые двери',
    intro: 'Входные и межкомнатные двери из алюминиевого профиля для жилых и общественных зданий.',
    points: [
      'Входные двери с терморазрывом (Алютех KT-60, Алюмарк ALT-72)',
      'Балконные и межкомнатные двери',
      'Распашные, маятниковые, двупольные',
      'Доводчики, электромагнитные замки, системы контроля доступа',
      'Закалённое стекло 6–10 мм, триплекс',
    ],
  },
  {
    slug: 'sliding',
    title: 'Раздвижные системы',
    intro: 'Sliding, lift&slide и складные системы для террас, лоджий и больших проёмов.',
    points: [
      'Sliding-системы (Алютех SL-160, Татпроф 500-2)',
      'Lift & Slide с подъёмно-сдвижной фурнитурой (до 200 кг створка)',
      'Складные системы «гармошка»',
      'Низкий порог для безбарьерной среды',
      'Тёплый и холодный варианты',
    ],
  },
  {
    slug: 'facades',
    title: 'Фасадное остекление',
    intro: 'Структурные и полуструктурные фасады для коммерческих и общественных зданий.',
    points: [
      'Структурный фасад (Structural Glazing)',
      'Полуструктурный фасад',
      'Зенитные фонари, атриумы',
      'Двухслойные и трёхслойные стеклопакеты',
      'Стекло с солнцезащитой и низкоэмиссионным покрытием',
    ],
  },
  {
    slug: 'pergolas',
    title: 'Перголы и навесы',
    intro: 'Биоклиматические перголы с регулируемыми ламелями и навесы для любых задач.',
    points: [
      'Биоклиматические перголы с поворотными ламелями (0–135°)',
      'Перголы с раздвижной тканевой крышей',
      'Навесы для авто, террас, бассейнов',
      'Интеграция LED-освещения и тепловых панелей',
      'Снеговые и ветровые нагрузки по СП 20.13330',
    ],
  },
  {
    slug: 'partitions',
    title: 'Перегородки',
    intro: 'Алюминиевые перегородки для офисов, торговых залов и квартир.',
    points: [
      'Стационарные и раздвижные перегородки',
      'Цельностеклянные перегородки (12 мм закалка)',
      'Алюминиевые каркасные перегородки (Алютех)',
      'Звукоизоляция до 45 дБ',
      'Интеграция жалюзи и рольставней',
    ],
  },
];
---

<Base
  path="/services/"
  title="Услуги"
  description="Алюминиевые окна, двери, раздвижные системы, фасады, перголы и перегородки. Профильные системы Алюмарк, Алютех, Татпроф. Москва и МО."
>
  <!-- Заголовок страницы -->
  <Section variant="paper" padding="lg">
    <p class="eyebrow">Услуги</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight md:text-5xl">
      Алюминиевые светопрозрачные конструкции
    </h1>
    <p class="mt-5 max-w-2xl text-graphite">
      Полный цикл — проектирование, производство, монтаж. Шесть основных направлений,
      каждое с сертифицированными профильными системами
      {site.profileSystems.join(', ')}.
    </p>
  </Section>

  <!-- Подробный список -->
  <Section variant="cream" padding="md">
    <div class="space-y-12">
      {services.map((s) => (
        <article id={s.slug} class="grid grid-cols-1 gap-8 md:grid-cols-12 md:scroll-mt-24">
          <header class="md:col-span-5">
            <h2 class="text-2xl font-semibold tracking-tight">{s.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-graphite">{s.intro}</p>
          </header>
          <ul class="md:col-span-7 space-y-2.5">
            {s.points.map((point) => (
              <li class="flex items-start gap-3 text-sm text-graphite">
                <span class="mt-1.5 h-1 w-1 flex-none rounded-full bg-bronze" aria-hidden="true"></span>
                {point}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <CTA />
</Base>
