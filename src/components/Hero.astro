---
import Section from './Section.astro';
import Button from './Button.astro';
import ProfileBadges from './ProfileBadges.astro';
---

<!-- ============================================================
     HERO — главная, уровень каркаса.
     Изображение-плейсхолдер через CSS-градиент + сетка.
     ============================================================ -->
<section class="relative overflow-hidden bg-anthracite text-paper grain">
  <!-- Фоновая сетка-плейсхолдер вместо картинки -->
  <div
    class="absolute inset-0 opacity-[0.15]"
    style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 80px 80px;"
    aria-hidden="true"
  >
  </div>
  <!-- Бронзовый градиент-свечение -->
  <div
    class="absolute -right-32 top-0 h-[600px] w-[600px] rounded-full opacity-30 blur-3xl"
    style="background: radial-gradient(circle, #b8865b 0%, transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative z-10 py-24 md:py-36">
    <div class="max-w-3xl">
      <p class="eyebrow text-bronze-light">Москва · Московская область</p>
      <h1 class="mt-5 text-4xl font-semibold leading-[1.05] tracking-tight md:text-6xl md:leading-[1.02]">
        Алюминиевые<br />
        <span class="text-bronze-light">конструкции</span><br />
        под ключ
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-paper/80 md:text-lg">
        Проектируем, производим и монтируем светопрозрачные алюминиевые системы:
        окна, двери, раздвижные конструкции, фасады, перголы.
        Сертифицированные профильные системы Алюмарк, Алютех, Татпроф.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button href="/contacts/#form" variant="on-dark" size="lg">
          Получить расчёт
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </Button>
        <Button href="/services/" variant="ghost" size="lg" class="text-paper/80 hover:text-bronze-light">
          Услуги →
        </Button>
      </div>

      <div class="mt-12">
        <ProfileBadges />
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     TRUST STRIP — мини-блок с цифрами/фактами
     ============================================================ -->
<Section variant="paper" padding="md">
  <dl class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4">
    <div>
      <dt class="text-xs uppercase tracking-widest text-graphite-soft">Опыт</dt>
      <dd class="mt-2 text-2xl font-semibold text-anthracite">12+ лет</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-graphite-soft">Объектов сдано</dt>
      <dd class="mt-2 text-2xl font-semibold text-anthracite">500+</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-graphite-soft">Профильные системы</dt>
      <dd class="mt-2 text-2xl font-semibold text-anthracite">3 бренда</dd>
    </div>
    <div>
      <dt class="text-xs uppercase tracking-widest text-graphite-soft">Гарантия</dt>
      <dd class="mt-2 text-2xl font-semibold text-anthracite">5 лет</dd>
    </div>
  </dl>
  <p class="mt-6 text-xs text-graphite-soft">
    *Данные приведены для каркаса MVP — заменить на боевые показатели перед продакшеном.
  </p>
</Section>
