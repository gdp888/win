---
import Section from './Section.astro';

interface Service {
  slug: string;
  title: string;
  description: string;
  icon: string; // SVG path data, 24x24 viewBox
}

const services: Service[] = [
  {
    slug: 'windows',
    title: 'Алюминиевые окна',
    description: 'Тёплые и холодные алюминиевые окна для квартир, домов и коммерческих помещений.',
    icon: 'M4 4h16v16H4V4zm4 0v16M12 4v16M16 4v16',
  },
  {
    slug: 'doors',
    title: 'Алюминиевые двери',
    description: 'Входные группы, межкомнатные, балконные двери. Входные двери с терморазрывом.',
    icon: 'M6 4h12v16H6V4zm6 0v16M6 12h12',
  },
  {
    slug: 'sliding',
    title: 'Раздвижные системы',
    description: 'Sliding-системы, lift&slide, складные конструкции. Под террасу, лоджию, витрину.',
    icon: 'M3 6h18v4H3V6zm0 8h18v4H3v-4zm4 2h2M11 16h2',
  },
  {
    slug: 'facades',
    title: 'Фасадное остекление',
    description: 'Структурные и полуструктурные фасады, зенитные фонари, atrium-решения.',
    icon: 'M3 3h18v18H3V3zm9 0v18M3 12h18',
  },
  {
    slug: 'pergolas',
    title: 'Перголы и навесы',
    description: 'Биоклиматические перголы с ламелями, навесы для авто, террас, бассейнов.',
    icon: 'M3 8h18v2H3V8zm2 4v8M19 12v8M8 20v-4M16 20v-4',
  },
  {
    slug: 'partitions',
    title: 'Перегородки',
    description: 'Алюминиевые перегородки для офисов, торговых залов, квартир. Стекло + алюминий.',
    icon: 'M4 4v16M20 4v16M4 4h16M4 12h16M4 20h16',
  },
];
---

<Section variant="cream" padding="lg" id="services">
  <div class="max-w-2xl">
    <p class="eyebrow">Услуги</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
      Что мы делаем
    </h2>
    <p class="mt-4 text-graphite">
      Полный цикл по алюминиевым светопрозрачным конструкциям — от замера и проектирования
      до производства и монтажа. Работаем с тремя профильными системами.
    </p>
  </div>

  <ul class="mt-12 grid grid-cols-1 gap-px bg-mist sm:grid-cols-2 lg:grid-cols-3">
    {services.map((service) => (
      <li class="group bg-paper p-7 transition-colors hover:bg-bronze-pale">
        <a href={`/services/#${service.slug}`} class="block">
          <div class="flex h-12 w-12 items-center justify-center rounded-md border border-mist bg-cream text-anthracite transition-colors group-hover:border-bronze group-hover:bg-bronze group-hover:text-paper">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={service.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold tracking-tight">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-graphite">{service.description}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-bronze">
            Подробнее
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Section>
